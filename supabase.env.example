# Copie ce fichier en « supabase.env » et remplis les deux valeurs
# (Supabase → Project Settings → API / API Keys), puis relance « make ».
#
# Ces valeurs sont publiques par conception : elles sont intégrées au launcher.
# La sécurité repose sur les règles d'accès (RLS) de supabase/schema.sql.
# Ne mets JAMAIS ici la clé service_role / sb_secret_… !

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Facultatif : webhook Discord qui reçoit les rapports de plantage (bouton « Envoyer sur Discord »).
# Il finit dans le launcher : n'importe qui peut le lire, donc un salon dédié aux rapports.
DISCORD_WEBHOOK=
